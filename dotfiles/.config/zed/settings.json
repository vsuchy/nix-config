{
  // ---------------
  // --- General ---
  // ---------------

  "auto_update": false,
  "suggest_extensions": false,

  "disable_ai": true,

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "cli_default_open_behavior": "new_window",
  "default_open_behavior": "new_window",
  "on_new_window": "empty_tab",
  "restore_on_file_reopen": false,

  "session": {
    "trust_all_worktrees": true
  },

  // --------------
  // --- Zed UI ---
  // --------------

  // --- General ---

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Dracula"
  },

  "ui_font_size": 14,

  // --- Buffer ---

  "buffer_font_family": "Cascadia Code NF",
  "buffer_font_size": 13,
  "buffer_line_height": "standard",

  "indent_guides": { "enabled": false },
  "scroll_beyond_last_line": "off",
  "wrap_guides": [ 120 ],

  "git": {
    "inline_blame": { "enabled": false }
  },

  // --- Navigation ---

  "command_palette": {
    "use_command_history": false
  },

  "preview_tabs": { "enabled": false },

  // --- Bars ---

  "scrollbar": {
    "show": "always",
    "cursors": false,
    "selected_text": false
  },

  "status_bar": {
    "active_encoding_button": "enabled",
    "line_endings_button": true
  },

  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },

  "title_bar": {
    "show_sign_in": false
  },

  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },

  // --- Panels ---

  "collaboration_panel": { "button": false },
  "debugger": { "button": false },
  "outline_panel": { "button": false },

  "project_panel": {
    "default_width": 300,
    "dock": "left",
    "entry_spacing": "standard",

    "auto_fold_dirs": false,
    "auto_reveal_entries": false
  },

  // -----------------------
  // --- Text formatting ---
  // -----------------------

  "line_ending": "enforce_lf",
  "tab_size": 2
}
